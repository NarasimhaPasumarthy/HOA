# Model provider for BOTH chat and embeddings: openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
CHAT_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

PORT=8083
CHROMA_HOST=localhost
CHROMA_PORT=8000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BM25_INDEX_PATH=data/bm25-index.sqlite3

HOA_DOCUMENT_FOLDER_PATH=
HOA_DOCUMENT_LOADING_ENABLED=false
HOA_OCR_ENABLED=true
HOA_OCR_LANGUAGE=eng
HOA_OCR_TESSERACT_PATH=
HOA_OCR_TESSDATA_PATH=
LOG_PROMPTS=false
